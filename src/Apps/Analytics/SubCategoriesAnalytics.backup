// Enhanced function to analyze ALL months performance for sub-categories
const analyzeAllMonthsSubCategoryPerformance = (transactions) => {
  if (!transactions || transactions.length === 0) {
    return {
      monthlyData: [],
      yearlySummary: {
        totalIncome: 0,
        totalExpense: 0,
        totalNetFlow: 0,
        totalTransactions: 0,
        averageMonthlyIncome: 0,
        averageMonthlyExpense: 0,
        bestMonth: null,
        worstMonth: null,
        growthRate: 0,
        monthlyAverages: [],
        highValue: 0,
        lowValue: 0,
        dayBreakdown: {},
        weekdayBreakdown: {},
      }
    };
  }

  const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
  const monthlyData = [];
  const allAmounts = [];
  let yearlyIncome = 0;
  let yearlyExpense = 0;
  let yearlyTransactions = 0;
  const dayBreakdown = {};
  const weekdayBreakdown = {};

  // Initialize monthly data
  for (let i = 0; i < 12; i++) {
    monthlyData.push({
      month: monthNames[i],
      monthIndex: i,
      income: 0,
      expense: 0,
      netFlow: 0,
      transactionCount: 0,
      averageTransaction: 0,
      monthlyAverage: 0,
      highValue: 0,
      lowValue: 0,
      dailyBreakdown: {},
      weeklyBreakdown: {},
      hourlyBreakdown: {},
      topSubCategories: [],
      peakDay: null,
      peakHour: null,
      peakWeekDay: null,
    });
  }

  // Process transactions for each month
  transactions.forEach((transaction) => {
    const transactionDate = new Date(transaction.Date);
    const monthIndex = transactionDate.getMonth();
    const accountAmount = parseFloat(transaction.AccountAmount) || 0;
    
    if (monthIndex >= 0 && monthIndex < 12) {
      allAmounts.push(Math.abs(accountAmount));
      
      if (accountAmount > 0) {
        monthlyData[monthIndex].income += accountAmount;
        yearlyIncome += accountAmount;
      } else {
        monthlyData[monthIndex].expense += Math.abs(accountAmount);
        yearlyExpense += Math.abs(accountAmount);
      }
      
      monthlyData[monthIndex].transactionCount++;
      yearlyTransactions++;
      
      // Track high/low values for each month
      if (Math.abs(accountAmount) > monthlyData[monthIndex].highValue) {
        monthlyData[monthIndex].highValue = Math.abs(accountAmount);
      }
      if (monthlyData[monthIndex].lowValue === 0 || Math.abs(accountAmount) < monthlyData[monthIndex].lowValue) {
        monthlyData[monthIndex].lowValue = Math.abs(accountAmount);
      }
      
      // Daily breakdown (1-31)
      const day = transactionDate.getDate();
      if (!monthlyData[monthIndex].dailyBreakdown[day]) {
        monthlyData[monthIndex].dailyBreakdown[day] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].dailyBreakdown[day].income += accountAmount;
      } else {
        monthlyData[monthIndex].dailyBreakdown[day].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].dailyBreakdown[day].count++;
      
      // Global day breakdown (1-31)
      if (!dayBreakdown[day]) {
        dayBreakdown[day] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        dayBreakdown[day].income += accountAmount;
      } else {
        dayBreakdown[day].expense += Math.abs(accountAmount);
      }
      dayBreakdown[day].count++;
      
      // Weekly breakdown (Mon, Tue, Wed, etc.)
      const dayOfWeek = transactionDate.toLocaleDateString('en-US', { weekday: 'short' });
      if (!monthlyData[monthIndex].weeklyBreakdown[dayOfWeek]) {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].income += accountAmount;
      } else {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].count++;
      
      // Global weekday breakdown
      if (!weekdayBreakdown[dayOfWeek]) {
        weekdayBreakdown[dayOfWeek] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        weekdayBreakdown[dayOfWeek].income += accountAmount;
      } else {
        weekdayBreakdown[dayOfWeek].expense += Math.abs(accountAmount);
      }
      weekdayBreakdown[dayOfWeek].count++;
      
      // Hourly breakdown
      const hour = transactionDate.getHours();
      if (!monthlyData[monthIndex].hourlyBreakdown[hour]) {
        monthlyData[monthIndex].hourlyBreakdown[hour] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].hourlyBreakdown[hour].income += accountAmount;
      } else {
        monthlyData[monthIndex].hourlyBreakdown[hour].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].hourlyBreakdown[hour].count++;
    }
  });

  // Calculate monthly metrics
  monthlyData.forEach((month, index) => {
    month.netFlow = month.income - month.expense;
    month.averageTransaction = month.transactionCount > 0 ? (month.income + month.expense) / month.transactionCount : 0;
    month.monthlyAverage = (month.income + month.expense) / 2;
    
    // Find peak day, hour, and weekday for each month
    month.peakDay = Object.entries(month.dailyBreakdown)
      .reduce((max, [day, data]) => 
        data.count > max.count ? { day: parseInt(day, 10), ...data } : max, 
        { day: 1, count: 0 }
      );
    
    month.peakHour = Object.entries(month.hourlyBreakdown)
      .reduce((max, [hour, data]) => 
        data.count > max.count ? { hour: parseInt(hour, 10), ...data } : max, 
        { hour: 0, count: 0 }
      );
    
    month.peakWeekDay = Object.entries(month.weeklyBreakdown)
      .reduce((max, [day, data]) => 
        data.count > max.count ? { day, ...data } : max, 
        { day: 'Mon', count: 0 }
      );
  });

  const yearlyNetFlow = yearlyIncome - yearlyExpense;
  const averageMonthlyIncome = yearlyIncome / 12;
  const averageMonthlyExpense = yearlyExpense / 12;
  const monthlyAverages = monthlyData.map(month => month.monthlyAverage);
  
  // Find best and worst months
  const bestMonth = monthlyData.reduce((max, month) => 
    month.netFlow > max.netFlow ? month : max, monthlyData[0]);
  const worstMonth = monthlyData.reduce((min, month) => 
    month.netFlow < min.netFlow ? month : min, monthlyData[0]);
  
  // Calculate growth rate
  const firstMonth = monthlyData.find(m => m.income > 0 || m.expense > 0);
  const lastMonth = monthlyData.slice().reverse().find(m => m.income > 0 || m.expense > 0);
  const growthRate = firstMonth && lastMonth ? 
    ((lastMonth.netFlow - firstMonth.netFlow) / Math.abs(firstMonth.netFlow)) * 100 : 0;

  // Find peak day and weekday globally
  const peakDay = Object.entries(dayBreakdown)
    .reduce((max, [day, data]) => 
      data.count > max.count ? { day: parseInt(day, 10), ...data } : max, 
      { day: 1, count: 0 }
    );

  const peakWeekDay = Object.entries(weekdayBreakdown)
    .reduce((max, [day, data]) => 
      data.count > max.count ? { day, ...data } : max, 
      { day: 'Mon', count: 0 }
    );

  return {
    monthlyData,
    yearlySummary: {
      totalIncome: yearlyIncome,
      totalExpense: yearlyExpense,
      totalNetFlow: yearlyNetFlow,
      totalTransactions: yearlyTransactions,
      averageMonthlyIncome,
      averageMonthlyExpense,
      bestMonth,
      worstMonth,
      growthRate,
      monthlyAverages,
      highValue: allAmounts.length > 0 ? Math.max(...allAmounts) : 0,
      lowValue: allAmounts.length > 0 ? Math.min(...allAmounts) : 0,
      dayBreakdown,
      weekdayBreakdown,
      peakDay,
      peakWeekDay,
    }
  };
};

// Enhanced function to get month performance for all sub-categories
const getMonthPerformanceForAllSubCategories = (categories, selectedMonth) => {
  const monthMap = {
    'JAN': 0, 'FEB': 1, 'MAR': 2, 'APR': 3, 'MAY': 4, 'JUN': 5,
    'JUL': 6, 'AUG': 7, 'SEP': 8, 'OCT': 9, 'NOV': 10, 'DEC': 11
  };

  const currentYear = new Date().getFullYear();
  const selectedMonthIndex = monthMap[selectedMonth] || 0;
  const monthName = new Date(currentYear, selectedMonthIndex).toLocaleDateString('en-US', { month: 'long' });

  return categories.map(category => {
    const totalIncome = Number(category?.TransactionSummary?.TotalInCome) || 0;
    const totalExpense = Number(category?.TransactionSummary?.TotalExpense) || 0;
    const netFlow = totalIncome - totalExpense;
    const transactionCount = category?.TransactionSummary?.TransactionCount || 0;
    
    // Enhanced health score calculation
    let healthScore = 0;
    if (totalIncome > 0 || totalExpense > 0) healthScore += 30; // Activity
    if (totalIncome > totalExpense) healthScore += 30; // Profitability
    if (category?.isActive) healthScore += 20; // Status
    if (transactionCount > 10) healthScore += 20; // Frequency
    
    const performance = healthScore >= 80 ? 'High' : healthScore >= 60 ? 'Medium' : 'Low';
    const efficiency = transactionCount > 0 ? (totalIncome + totalExpense) / transactionCount : 0;
    const monthlyAverage = (totalIncome + totalExpense) / 2;
    
    return {
      ...category,
      monthName,
      totalIncome,
      totalExpense,
      netFlow,
      transactionCount,
      healthScore,
      performance,
      efficiency,
      monthlyAverage,
      growthRate: totalExpense > 0 ? ((totalIncome - totalExpense) / totalExpense) * 100 : 0,
    };
  }).sort((a, b) => b.totalIncome - a.totalIncome);
};

export default function SubCategoriesAnalytics() {
  const dispatch = useDispatch();
  const [activeTab, setActiveTab] = useState(0);
  const [selectedSubCategory, setSelectedSubCategory] = useState(null);
  const [subCategoriesList, setSubCategoriesList] = useState([]);
  const [selectedMonth, setSelectedMonth] = useState('JAN');
  const [monthPerformance, setMonthPerformance] = useState(null);
  const [allMonthsData, setAllMonthsData] = useState(null);
  const [subCategoryTransactions, setSubCategoryTransactions] = useState([]);
  const [loading, setLoading] = useState(false);

  const [summaryData, setSummaryData] = useState({
    totalSubCategories: 0,
    activeSubCategories: 0,
    totalIncome: 0,
    totalExpense: 0,
    highPerformanceSubCategories: 0,
    averageEfficiency: 0,
    topPerformer: null,
    monthlyAverage: 0,
    highValue: 0,
    lowValue: 0,
  });

  const calculateSummary = () => {
    const activeSubCategories = subCategoriesList.filter((cat) => cat?.isActive);
    const performanceData = getMonthPerformanceForAllSubCategories(subCategoriesList, selectedMonth);
    
    const totalIncome = performanceData.reduce((sum, cat) => sum + cat.totalIncome, 0);
    const totalExpense = performanceData.reduce((sum, cat) => sum + cat.totalExpense, 0);
    const highPerformanceSubCategories = performanceData.filter(cat => cat.performance === 'High').length;
    const averageEfficiency = performanceData.length > 0 ? 
      performanceData.reduce((sum, cat) => sum + cat.efficiency, 0) / performanceData.length : 0;
    const topPerformer = performanceData[0];
    const monthlyAverage = (totalIncome + totalExpense) / 2;
    const allAmounts = performanceData.flatMap(cat => [cat.totalIncome, cat.totalExpense]);
    const highValue = allAmounts.length > 0 ? Math.max(...allAmounts) : 0;
    const lowValue = allAmounts.length > 0 ? Math.min(...allAmounts) : 0;

    setSummaryData({
      totalSubCategories: subCategoriesList.length,
      activeSubCategories: activeSubCategories.length,
      totalIncome,
      totalExpense,
      highPerformanceSubCategories,
      averageEfficiency,
      topPerformer,
      monthlyAverage,
      highValue,
      lowValue,
    });
  };

  // Fetch transactions for selected sub-category and month
  const fetchSubCategoryTransactions = (subCategoryId) => {
    if (!subCategoryId) return;
    
    setLoading(true);
    const payload = {
      FilterBy: { SubCategoryId: subCategoryId },
      Duration: 'All'
    };
    
    dispatch(
      TransactionFetchListService(payload, (res) => {
        if (res?.status) {
          setSubCategoryTransactions(res?.data?.list || []);
          const analytics = analyzeAllMonthsSubCategoryPerformance(res?.data?.list || []);
          setAllMonthsData(analytics);
        }
        setLoading(false);
      })
    );
  };

  const handleTabChange = (event, newValue) => {
    setActiveTab(newValue);
  };

  const handleSubCategorySelect = (subCategory) => {
    setSelectedSubCategory(subCategory);
    setActiveTab(1);
  };

  const handleMonthChange = (month) => {
    setSelectedMonth(month);
    if (selectedSubCategory?.SubCategoryId) {
      fetchSubCategoryTransactions(selectedSubCategory.SubCategoryId);
    }
  };

  useEffect(() => {
    // For now, we'll use categories as sub-categories
    // In a real app, you'd have a separate sub-categories service
    dispatch(
      CategoriesFetchListService({}, (res) => {
        if (res?.status) {
          setSubCategoriesList(res?.data?.list);
        }
      })
    );
  }, []);

  useEffect(() => {
    if (selectedSubCategory?.CategoryId) {
      fetchSubCategoryTransactions(selectedSubCategory.CategoryId);
    }
  }, [selectedSubCategory]);

  useEffect(() => {
    if (subCategoriesList?.length > 0) {
      calculateSummary();
    }
  }, [subCategoriesList, selectedMonth]);

  const renderOverview = () => {
    const performanceData = getMonthPerformanceForAllSubCategories(subCategoriesList, selectedMonth);
    
    return (
      <Box>
        <CardHeader
          title={
            <Typography variant="h6" sx={{ fontWeight: 600 }}>
              Sub-Categories Performance - {performanceData[0]?.monthName || selectedMonth}
            </Typography>
          }
          subheader={`${summaryData.totalSubCategories} total sub-categories • ${summaryData.activeSubCategories} active • ${summaryData.highPerformanceSubCategories} high performing`}
          action={
            <Stack direction="row" spacing={2} alignItems="center">
              <CustomSelect
                valueKey="Key"
                labelKey="Value"
                size="small"
                sx={{ width: 120 }}
                menuList={MonthList}
                defaultValue={selectedMonth}
                callBackAction={handleMonthChange}
              />
            </Stack>
          }
        />

        <Box sx={{ p: 2 }}>
          {/* Enhanced Summary Cards */}
          <Grid container spacing={2} sx={{ mb: 3 }}>
            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter' }}>
                <AttachMoneyIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.totalIncome}
                  format="currency"
                  variant="h5"
                  color="success.main"
                  duration={2000}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Total Income
                </Typography>
                <Typography variant="caption" color="success.main">
                  {selectedMonth} Performance
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter' }}>
                <TrendingDownIcon sx={{ fontSize: 32, color: 'error.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.totalExpense}
                  format="currency"
                  variant="h5"
                  color="error.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Total Expense
                </Typography>
                <Typography variant="caption" color="error.main">
                  {selectedMonth} Performance
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'info.lighter' }}>
                <SpeedIcon sx={{ fontSize: 32, color: 'info.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.activeSubCategories}
                  format="number"
                  variant="h5"
                  color="info.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Active Sub-Categories
                </Typography>
                <Typography variant="caption" color="info.main">
                  {summaryData?.totalSubCategories > 0
                    ? Math.round((summaryData.activeSubCategories / summaryData.totalSubCategories) * 100)
                    : 0}
                  % of total
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'warning.lighter' }}>
                <AssessmentIcon sx={{ fontSize: 32, color: 'warning.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.highPerformanceSubCategories}
                  format="number"
                  variant="h5"
                  color="warning.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  High Performance
                </Typography>
                <Typography variant="caption" color="warning.main">
                  Top performers
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'primary.lighter' }}>
                <BarChartIcon sx={{ fontSize: 32, color: 'primary.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.monthlyAverage}
                  format="currency"
                  variant="h5"
                  color="primary.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Monthly Average
                </Typography>
                <Typography variant="caption" color="primary.main">
                  All sub-categories
                </Typography>
              </Card>
            </Grid>
          </Grid>

          {/* High/Low Value Cards */}
          <Grid container spacing={2} sx={{ mb: 3 }}>
            <Grid item xs={12} sm={6} md={6}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter', border: '2px solid', borderColor: 'success.main' }}>
                <TrendingUpIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.highValue}
                  format="currency"
                  variant="h5"
                  color="success.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Highest Value
                </Typography>
                <Typography variant="caption" color="success.main">
                  Single transaction
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={6}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter', border: '2px solid', borderColor: 'error.main' }}>
                <TrendingDownIcon sx={{ fontSize: 32, color: 'error.main', mb: 1 }} />
                <AnimatedCounter
                  value={summaryData?.lowValue}
                  format="currency"
                  variant="h5"
                  color="error.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Lowest Value
                </Typography>
                <Typography variant="caption" color="error.main">
                  Single transaction
                </Typography>
              </Card>
            </Grid>
          </Grid>

          {/* Enhanced Charts */}
          <Grid container spacing={3} sx={{ mb: 3 }}>
            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title={`Monthly Income vs Expense - ${selectedMonth}`}
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: [selectedMonth],
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: [summaryData?.totalIncome || 0],
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: [summaryData?.totalExpense || 0],
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Performance Distribution"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: ['High', 'Medium', 'Low'],
                    series: [
                      {
                        name: 'Sub-Categories',
                        type: 'pie',
                        data: [
                          performanceData.filter(cat => cat.performance === 'High').length,
                          performanceData.filter(cat => cat.performance === 'Medium').length,
                          performanceData.filter(cat => cat.performance === 'Low').length,
                        ],
                      },
                    ],
                    options: {
                      colors: ['#00A76F', '#FFA726', '#FF4842'],
                    },
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Top Sub-Categories Performance"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: performanceData.slice(0, 8).map(item => item.CategoryName),
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: performanceData.slice(0, 8).map(item => item.totalIncome),
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: performanceData.slice(0, 8).map(item => item.totalExpense),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Monthly Average Comparison"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: performanceData.slice(0, 10).map(item => item.CategoryName),
                    series: [
                      {
                        name: 'Monthly Average',
                        type: 'line',
                        fill: 'gradient',
                        color: '#8E44AD',
                        data: performanceData.slice(0, 10).map(item => item.monthlyAverage),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>
          </Grid>

          {/* Enhanced Performance Table */}
          <Card sx={{ mb: 3 }}>
            <CardHeader
              title={
                <Typography variant="h6" sx={{ fontWeight: 600 }}>
                  Detailed Sub-Category Performance - {selectedMonth}
                </Typography>
              }
              subheader="Comprehensive monthly performance analysis with averages and value ranges"
            />
            <TableContainer>
              <Table>
                <TableHead>
                  <TableRow>
                    <TableCell>Sub-Category</TableCell>
                    <TableCell align="right">Income</TableCell>
                    <TableCell align="right">Expense</TableCell>
                    <TableCell align="right">Net Flow</TableCell>
                    <TableCell align="right">Monthly Avg</TableCell>
                    <TableCell align="right">Transactions</TableCell>
                    <TableCell align="center">Performance</TableCell>
                    <TableCell align="center">Status</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {performanceData.map((subCategory, index) => (
                    <TableRow key={index} hover>
                      <TableCell>
                        <Stack direction="row" alignItems="center" spacing={1}>
                          <CustomAvatar
                            width={30}
                            height={30}
                            iconSize={12}
                            icon={subCategory?.Icon || 'category'}
                            bgColor={subCategory?.Color || '#00A76F'}
                          />
                          <Box>
                            <Typography variant="body2" sx={{ fontWeight: 500 }}>
                              {subCategory.CategoryName}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {subCategory.Description || 'No description'}
                            </Typography>
                          </Box>
                        </Stack>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" color="success.main" sx={{ fontWeight: 500 }}>
                          ₹{subCategory.totalIncome.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" color="error.main" sx={{ fontWeight: 500 }}>
                          ₹{subCategory.totalExpense.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Stack
                          direction="row"
                          alignItems="center"
                          justifyContent="flex-end"
                          spacing={0.5}
                        >
                          {subCategory.netFlow >= 0 ? (
                            <TrendingUpIcon sx={{ fontSize: 16, color: 'success.main' }} />
                          ) : (
                            <TrendingDownIcon sx={{ fontSize: 16, color: 'error.main' }} />
                          )}
                          <Typography
                            variant="body2"
                            color={subCategory.netFlow >= 0 ? 'success.main' : 'error.main'}
                            sx={{ fontWeight: 500 }}
                          >
                            ₹{subCategory.netFlow.toFixed(2)}
                          </Typography>
                        </Stack>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" sx={{ fontWeight: 500 }}>
                          ₹{subCategory.monthlyAverage.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" sx={{ fontWeight: 500 }}>
                          {subCategory.transactionCount}
                        </Typography>
                      </TableCell>

                      <TableCell align="center">
                        <Chip
                          label={subCategory.performance}
                          size="small"
                          color={subCategory.performance === 'High' ? 'success' : subCategory.performance === 'Medium' ? 'warning' : 'error'}
                          variant="outlined"
                        />
                      </TableCell>

                      <TableCell align="center">
                        <Stack direction="row" spacing={1} justifyContent="center">
                          <Chip
                            label={subCategory.isActive ? 'Active' : 'Inactive'}
                            size="small"
                            color={subCategory.isActive ? 'success' : 'default'}
                            variant="outlined"
                          />
                        </Stack>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
          </Card>
        </Box>
      </Box>
    );
  };

  const renderSelectedSubCategory = () => {
    if (!selectedSubCategory) {
      return (
        <Box sx={{ textAlign: 'center', py: 8 }}>
          <CategoryIcon sx={{ fontSize: 64, color: 'text.disabled', mb: 2 }} />
          <Typography variant="h6" color="text.secondary" sx={{ mb: 1 }}>
            No Sub-Category Selected
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Select a sub-category from the overview to view detailed analytics
          </Typography>
        </Box>
      );
    }

    if (loading) {
      return (
        <Box sx={{ textAlign: 'center', py: 8 }}>
          <Typography variant="h6" color="text.secondary">
            Loading sub-category analytics...
          </Typography>
        </Box>
      );
    }

    const analytics = allMonthsData?.yearlySummary || {};
    const monthlyData = allMonthsData?.monthlyData || [];
    const transactions = subCategoryTransactions || [];

    return (
      <Box>
        <CardHeader
          title={
            <Typography variant="h6" sx={{ fontWeight: 600 }}>
              {selectedSubCategory.CategoryName} - Detailed Analytics
            </Typography>
          }
          subheader={`${transactions.length} transactions • ${analytics.totalTransactions || 0} total • ${selectedMonth} focus`}
          action={
            <Stack direction="row" spacing={2} alignItems="center">
              <CustomSelect
                valueKey="Key"
                labelKey="Value"
                size="small"
                sx={{ width: 120 }}
                menuList={MonthList}
                defaultValue={selectedMonth}
                callBackAction={handleMonthChange}
              />
            </Stack>
          }
        />

        <Box sx={{ p: 2 }}>
          {/* Key Metrics Cards */}
          <Grid container spacing={2} sx={{ mb: 3 }}>
            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter' }}>
                <AttachMoneyIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.totalIncome || 0}
                  format="currency"
                  variant="h5"
                  color="success.main"
                  duration={2000}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Total Income
                </Typography>
                <Typography variant="caption" color="success.main">
                  All time
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter' }}>
                <TrendingDownIcon sx={{ fontSize: 32, color: 'error.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.totalExpense || 0}
                  format="currency"
                  variant="h5"
                  color="error.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Total Expense
                </Typography>
                <Typography variant="caption" color="error.main">
                  All time
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'info.lighter' }}>
                <SpeedIcon sx={{ fontSize: 32, color: 'info.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.totalTransactions || 0}
                  format="number"
                  variant="h5"
                  color="info.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Total Transactions
                </Typography>
                <Typography variant="caption" color="info.main">
                  All time
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'warning.lighter' }}>
                <AssessmentIcon sx={{ fontSize: 32, color: 'warning.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.averageMonthlyIncome || 0}
                  format="currency"
                  variant="h5"
                  color="warning.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Monthly Avg Income
                </Typography>
                <Typography variant="caption" color="warning.main">
                  Per month
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={2.4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'primary.lighter' }}>
                <BarChartIcon sx={{ fontSize: 32, color: 'primary.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.averageMonthlyExpense || 0}
                  format="currency"
                  variant="h5"
                  color="primary.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Monthly Avg Expense
                </Typography>
                <Typography variant="caption" color="primary.main">
                  Per month
                </Typography>
              </Card>
            </Grid>
          </Grid>

          {/* High/Low Value Cards */}
          <Grid container spacing={2} sx={{ mb: 3 }}>
            <Grid item xs={12} sm={6} md={6}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter', border: '2px solid', borderColor: 'success.main' }}>
                <TrendingUpIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.highValue || 0}
                  format="currency"
                  variant="h5"
                  color="success.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Highest Value
                </Typography>
                <Typography variant="caption" color="success.main">
                  Single transaction
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} sm={6} md={6}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter', border: '2px solid', borderColor: 'error.main' }}>
                <TrendingDownIcon sx={{ fontSize: 32, color: 'error.main', mb: 1 }} />
                <AnimatedCounter
                  value={analytics.lowValue || 0}
                  format="currency"
                  variant="h5"
                  color="error.main"
                  duration={1500}
                />
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Lowest Value
                </Typography>
                <Typography variant="caption" color="error.main">
                  Single transaction
                </Typography>
              </Card>
            </Grid>
          </Grid>

          {/* Enhanced Charts */}
          <Grid container spacing={3} sx={{ mb: 3 }}>
            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Monthly Income vs Expense - All Months"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: monthlyData.map(month => month.month),
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: monthlyData.map(month => month.income),
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: monthlyData.map(month => month.expense),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Monthly Net Flow Trend"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: monthlyData.map(month => month.month),
                    series: [
                      {
                        name: 'Net Flow',
                        type: 'line',
                        fill: 'gradient',
                        color: '#8E44AD',
                        data: monthlyData.map(month => month.netFlow),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Daily Spending Pattern (1-31)"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: Object.keys(analytics.dayBreakdown || {}).map(day => `Day ${day}`),
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: Object.values(analytics.dayBreakdown || {}).map(day => day.income),
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: Object.values(analytics.dayBreakdown || {}).map(day => day.expense),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Weekly Spending Pattern (Mon-Sun)"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: Object.keys(analytics.weekdayBreakdown || {}),
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: Object.values(analytics.weekdayBreakdown || {}).map(day => day.income),
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: Object.values(analytics.weekdayBreakdown || {}).map(day => day.expense),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Monthly Average Trend"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: monthlyData.map(month => month.month),
                    series: [
                      {
                        name: 'Monthly Average',
                        type: 'line',
                        fill: 'gradient',
                        color: '#8E44AD',
                        data: monthlyData.map(month => month.monthlyAverage),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Transaction Count by Month"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: monthlyData.map(month => month.month),
                    series: [
                      {
                        name: 'Transactions',
                        type: 'bar',
                        fill: 'solid',
                        color: '#8E44AD',
                        data: monthlyData.map(month => month.transactionCount),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>
          </Grid>

          {/* Peak Performance Analysis */}
          <Grid container spacing={3} sx={{ mb: 3 }}>
            <Grid item xs={12} md={4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter' }}>
                <CalendarTodayIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                <Typography variant="h6" color="success.main" sx={{ fontWeight: 600 }}>
                  Peak Day
                </Typography>
                <Typography variant="h4" color="success.main" sx={{ fontWeight: 700, mb: 1 }}>
                  {analytics.peakDay?.day || 'N/A'}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  {analytics.peakDay?.count || 0} transactions
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} md={4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'info.lighter' }}>
                <TimelineIcon sx={{ fontSize: 32, color: 'info.main', mb: 1 }} />
                <Typography variant="h6" color="info.main" sx={{ fontWeight: 600 }}>
                  Peak Weekday
                </Typography>
                <Typography variant="h4" color="info.main" sx={{ fontWeight: 700, mb: 1 }}>
                  {analytics.peakWeekDay?.day || 'N/A'}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  {analytics.peakWeekDay?.count || 0} transactions
                </Typography>
              </Card>
            </Grid>

            <Grid item xs={12} md={4}>
              <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'warning.lighter' }}>
                <SpeedIcon sx={{ fontSize: 32, color: 'warning.main', mb: 1 }} />
                <Typography variant="h6" color="warning.main" sx={{ fontWeight: 600 }}>
                  Growth Rate
                </Typography>
                <Typography variant="h4" color="warning.main" sx={{ fontWeight: 700, mb: 1 }}>
                  {analytics.growthRate?.toFixed(1) || 0}%
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Year over year
                </Typography>
              </Card>
            </Grid>
          </Grid>

          {/* Recent Transactions Table */}
          <Card sx={{ mb: 3 }}>
            <CardHeader
              title={
                <Typography variant="h6" sx={{ fontWeight: 600 }}>
                  Recent Transactions
                </Typography>
              }
              subheader={`Latest ${Math.min(10, transactions.length)} transactions for ${selectedSubCategory.CategoryName}`}
            />
            <TableContainer>
              <Table>
                <TableHead>
                  <TableRow>
                    <TableCell>Date</TableCell>
                    <TableCell>Description</TableCell>
                    <TableCell align="right">Amount</TableCell>
                    <TableCell align="center">Type</TableCell>
                    <TableCell align="center">Status</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {transactions.slice(0, 10).map((transaction, index) => (
                    <TableRow key={index} hover>
                      <TableCell>
                        <Typography variant="body2">
                          {new Date(transaction.Date).toLocaleDateString()}
                        </Typography>
                      </TableCell>
                      <TableCell>
                        <Typography variant="body2" sx={{ fontWeight: 500 }}>
                          {transaction.Description || 'No description'}
                        </Typography>
                      </TableCell>
                      <TableCell align="right">
                        <Typography
                          variant="body2"
                          color={transaction.AccountAmount > 0 ? 'success.main' : 'error.main'}
                          sx={{ fontWeight: 500 }}
                        >
                          ₹{Math.abs(transaction.AccountAmount).toFixed(2)}
                        </Typography>
                      </TableCell>
                      <TableCell align="center">
                        <Chip
                          label={transaction.AccountAmount > 0 ? 'Income' : 'Expense'}
                          size="small"
                          color={transaction.AccountAmount > 0 ? 'success' : 'error'}
                          variant="outlined"
                        />
                      </TableCell>
                      <TableCell align="center">
                        <Chip
                          label={transaction.Status || 'Active'}
                          size="small"
                          color="default"
                          variant="outlined"
                        />
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
          </Card>
        </Box>
      </Box>
    );
  };

  return (
    <Box>
      <Box sx={{ borderBottom: 1, borderColor: 'divider', mb: 3 }}>
        <Tabs value={activeTab} onChange={handleTabChange} aria-label="sub-categories analytics tabs">
          <Tab
            label="All Sub-Categories Overview"
            icon={<AssessmentIcon />}
            iconPosition="start"
          />
          <Tab
            label="Selected Sub-Category"
            icon={<CategoryIcon />}
            iconPosition="start"
            disabled={!selectedSubCategory}
          />
        </Tabs>
      </Box>

      {activeTab === 0 && renderOverview()}
      {activeTab === 1 && renderSelectedSubCategory()}
    </Box>
  );
}
