                                        : 'error.main',
                                    fontWeight: 600,
                                  }}
                                >
                                  {formatToINR(transaction.Amount, isAmountVisible)}
                                </Typography>
                              </Box>
                              <Typography variant="caption" color="text.secondary">
                                {transaction.Details}
                              </Typography>
                              {transaction.Description && (
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  display="block"
                                >
                                  {transaction.Description}
                                </Typography>
                              )}
                            </Box>
                          ))}
                        </AccordionDetails>
                      </Accordion>
                    </Grid>
                  ))}
                </Grid>
              </Box> */}
            </Paper>
          </Grid>
        </Grid>
      </Card>
    </Box>
  );
}
