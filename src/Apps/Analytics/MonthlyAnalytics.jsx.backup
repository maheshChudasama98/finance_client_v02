                                +{formatToINR(day.realIncome, isAmountVisible)}
                              </Typography>
                              <Typography variant="body2" color="error.main">
                                -{formatToINR(day.realExpense, isAmountVisible)}
                              </Typography>
                            </Box>
                          </Box>
                        </AccordionSummary>
                        <AccordionDetails>
                          {day.transactions?.map((transaction, tIndex) => (
                            <Box
                              key={tIndex}
                              sx={{
                                mb: 1,
                                p: 1,
                                border: '1px solid',
                                borderColor: 'divider',
                                borderRadius: 1,
                              }}
                            >
                              <Box
                                sx={{
                                  display: 'flex',
                                  justifyContent: 'space-between',
                                  alignItems: 'center',
                                }}
                              >
                                <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                  {getActionIcon(transaction.Action)}
                                  <Typography variant="body2" sx={{ ml: 1 }}>
                                    {transaction.Action}
                                  </Typography>
                                </Box>
                                <Typography
                                  variant="body2"
                                  sx={{
                                    color:
                                      transaction.Action === 'In' || transaction.Action === 'Refund'
