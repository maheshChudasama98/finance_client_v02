import { AnimatedChart, AnimatedCounter } from 'src/components/Animated';
import { CustomAvatar, CustomSelect } from 'src/components/CustomComponents';

// Enhanced function to analyze ALL months performance for categories
const analyzeAllMonthsCategoryPerformance = (transactions) => {
  if (!transactions || transactions.length === 0) {
    return {
      monthlyData: [],
      yearlySummary: {
        totalIncome: 0,
        totalExpense: 0,
        totalNetFlow: 0,
        totalTransactions: 0,
        averageMonthlyIncome: 0,
        averageMonthlyExpense: 0,
        bestMonth: null,
        worstMonth: null,
        growthRate: 0,
        monthlyAverages: [],
        highValue: 0,
        lowValue: 0,
      },
    };
  }

  const monthNames = [
    'JAN',
    'FEB',
    'MAR',
    'APR',
    'MAY',
    'JUN',
    'JUL',
    'AUG',
    'SEP',
    'OCT',
    'NOV',
    'DEC',
  ];
  const monthlyData = [];
  const allAmounts = [];
  let yearlyIncome = 0;
  let yearlyExpense = 0;
  let yearlyTransactions = 0;

  // Initialize monthly data
  for (let i = 0; i < 12; i++) {
    monthlyData.push({
      month: monthNames[i],
      monthIndex: i,
      income: 0,
      expense: 0,
      netFlow: 0,
      transactionCount: 0,
      averageTransaction: 0,
      monthlyAverage: 0,
      highValue: 0,
      lowValue: 0,
      dailyBreakdown: {},
      weeklyBreakdown: {},
      hourlyBreakdown: {},
      topCategories: [],
      peakDay: null,
      peakHour: null,
      peakWeekDay: null,
    });
  }

  // Process transactions for each month
  transactions.forEach((transaction) => {
    const transactionDate = new Date(transaction.Date);
    const monthIndex = transactionDate.getMonth();
    const accountAmount = parseFloat(transaction.AccountAmount) || 0;

    if (monthIndex >= 0 && monthIndex < 12) {
      allAmounts.push(Math.abs(accountAmount));

      if (accountAmount > 0) {
        monthlyData[monthIndex].income += accountAmount;
        yearlyIncome += accountAmount;
      } else {
        monthlyData[monthIndex].expense += Math.abs(accountAmount);
        yearlyExpense += Math.abs(accountAmount);
      }

      monthlyData[monthIndex].transactionCount++;
      yearlyTransactions++;

      // Track high/low values for each month
      if (Math.abs(accountAmount) > monthlyData[monthIndex].highValue) {
        monthlyData[monthIndex].highValue = Math.abs(accountAmount);
      }
      if (
        monthlyData[monthIndex].lowValue === 0 ||
        Math.abs(accountAmount) < monthlyData[monthIndex].lowValue
      ) {
        monthlyData[monthIndex].lowValue = Math.abs(accountAmount);
      }

      // Daily breakdown
      const day = transactionDate.getDate();
      if (!monthlyData[monthIndex].dailyBreakdown[day]) {
        monthlyData[monthIndex].dailyBreakdown[day] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].dailyBreakdown[day].income += accountAmount;
      } else {
        monthlyData[monthIndex].dailyBreakdown[day].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].dailyBreakdown[day].count++;

      // Weekly breakdown
      const dayOfWeek = transactionDate.toLocaleDateString('en-US', { weekday: 'short' });
      if (!monthlyData[monthIndex].weeklyBreakdown[dayOfWeek]) {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].income += accountAmount;
      } else {
        monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].weeklyBreakdown[dayOfWeek].count++;

      // Hourly breakdown
      const hour = transactionDate.getHours();
      if (!monthlyData[monthIndex].hourlyBreakdown[hour]) {
        monthlyData[monthIndex].hourlyBreakdown[hour] = { income: 0, expense: 0, count: 0 };
      }
      if (accountAmount > 0) {
        monthlyData[monthIndex].hourlyBreakdown[hour].income += accountAmount;
      } else {
        monthlyData[monthIndex].hourlyBreakdown[hour].expense += Math.abs(accountAmount);
      }
      monthlyData[monthIndex].hourlyBreakdown[hour].count++;
    }
  });

  // Calculate monthly metrics
  monthlyData.forEach((month, index) => {
    month.netFlow = month.income - month.expense;
    month.averageTransaction =
      month.transactionCount > 0 ? (month.income + month.expense) / month.transactionCount : 0;
    month.monthlyAverage = (month.income + month.expense) / 2;

    // Find peak day, hour, and weekday for each month
    month.peakDay = Object.entries(month.dailyBreakdown).reduce(
      (max, [day, data]) => (data.count > max.count ? { day: parseInt(day, 10), ...data } : max),
      { day: 1, count: 0 }
    );

    month.peakHour = Object.entries(month.hourlyBreakdown).reduce(
      (max, [hour, data]) => (data.count > max.count ? { hour: parseInt(hour, 10), ...data } : max),
      { hour: 0, count: 0 }
    );

    month.peakWeekDay = Object.entries(month.weeklyBreakdown).reduce(
      (max, [day, data]) => (data.count > max.count ? { day, ...data } : max),
      { day: 'Mon', count: 0 }
    );
  });

  const yearlyNetFlow = yearlyIncome - yearlyExpense;
  const averageMonthlyIncome = yearlyIncome / 12;
  const averageMonthlyExpense = yearlyExpense / 12;
  const monthlyAverages = monthlyData.map((month) => month.monthlyAverage);

  // Find best and worst months
  const bestMonth = monthlyData.reduce(
    (max, month) => (month.netFlow > max.netFlow ? month : max),
    monthlyData[0]
  );
  const worstMonth = monthlyData.reduce(
    (min, month) => (month.netFlow < min.netFlow ? month : min),
    monthlyData[0]
  );

  // Calculate growth rate
  const firstMonth = monthlyData.find((m) => m.income > 0 || m.expense > 0);
  const lastMonth = monthlyData
    .slice()
    .reverse()
    .find((m) => m.income > 0 || m.expense > 0);
  const growthRate =
    firstMonth && lastMonth
      ? ((lastMonth.netFlow - firstMonth.netFlow) / Math.abs(firstMonth.netFlow)) * 100
      : 0;

  return {
    monthlyData,
    yearlySummary: {
      totalIncome: yearlyIncome,
      totalExpense: yearlyExpense,
      totalNetFlow: yearlyNetFlow,
      totalTransactions: yearlyTransactions,
      averageMonthlyIncome,
      averageMonthlyExpense,
      bestMonth,
      worstMonth,
      growthRate,
      monthlyAverages,
      highValue: allAmounts.length > 0 ? Math.max(...allAmounts) : 0,
      lowValue: allAmounts.length > 0 ? Math.min(...allAmounts) : 0,
    },
  };
};

const getMonthPerformanceForAllCategories = (categories, selectedMonth) => {
  const monthMap = {
    JAN: 0,
    FEB: 1,
    MAR: 2,
    APR: 3,
    MAY: 4,
    JUN: 5,
    JUL: 6,
    AUG: 7,
    SEP: 8,
    OCT: 9,
    NOV: 10,
    DEC: 11,
  };

  const currentYear = new Date().getFullYear();
  const selectedMonthIndex = monthMap[selectedMonth] || 0;
  const monthName = new Date(currentYear, selectedMonthIndex).toLocaleDateString('en-US', {
    month: 'long',
  });

  return categories
    .map((category) => {
      const totalIncome = Number(category?.TransactionSummary?.TotalInCome) || 0;
      const totalExpense = Number(category?.TransactionSummary?.TotalExpense) || 0;
      const netFlow = totalIncome - totalExpense;
      const transactionCount = category?.TransactionSummary?.TransactionCount || 0;

      // Enhanced health score calculation
      let healthScore = 0;
      if (totalIncome > 0 || totalExpense > 0) healthScore += 30; 
      if (totalIncome > totalExpense) healthScore += 30; 
      if (category?.isActive) healthScore += 20;
      if (transactionCount > 10) healthScore += 20;

      const performance = healthScore >= 80 ? 'High' : healthScore >= 60 ? 'Medium' : 'Low';
      const efficiency = transactionCount > 0 ? (totalIncome + totalExpense) / transactionCount : 0;
      const monthlyAverage = (totalIncome + totalExpense) / 2;

      return {
        ...category,
        monthName,
        totalIncome,
        totalExpense,
        netFlow,
        transactionCount,
        healthScore,
        performance,
        efficiency,
        monthlyAverage,
        growthRate: totalExpense > 0 ? ((totalIncome - totalExpense) / totalExpense) * 100 : 0,
      };
    })
    .sort((a, b) => b.totalExpense - a.totalExpense);
};

export default function CategoriesAnalytics() {
  const dispatch = useDispatch();
  const [activeTab, setActiveTab] = useState(0);
  const [selectedCategory, setSelectedCategory] = useState(null);
  const [categoriesList, setCategoriesList] = useState([]);
  const [selectedMonth, setSelectedMonth] = useState('JAN');
  const [monthPerformance, setMonthPerformance] = useState(null);
  const [allMonthsData, setAllMonthsData] = useState(null);
  const [categoryTransactions, setCategoryTransactions] = useState([]);

  const [loading, setLoading] = useState(false);
  const [loadingList, setLoadingList] = useState(false);

  const [summaryData, setSummaryData] = useState({
    totalCategories: 0,
    activeCategories: 0,
    totalIncome: 0,
    totalExpense: 0,
    highPerformanceCategories: 0,
    averageEfficiency: 0,
    topPerformer: null,
    monthlyAverage: 0,
    highValue: 0,
    lowValue: 0,
  });

  const calculateSummary = () => {
    const activeCategories = categoriesList.filter((cat) => cat?.isActive);
    const performanceData = getMonthPerformanceForAllCategories(categoriesList, selectedMonth);

    const totalIncome = performanceData.reduce((sum, cat) => sum + cat.totalIncome, 0);
    const totalExpense = performanceData.reduce((sum, cat) => sum + cat.totalExpense, 0);
    const highPerformanceCategories = performanceData.filter(
      (cat) => cat.performance === 'High'
    ).length;
    const averageEfficiency =
      performanceData.length > 0
        ? performanceData.reduce((sum, cat) => sum + cat.efficiency, 0) / performanceData.length
        : 0;
    const topPerformer = performanceData[0];
    const monthlyAverage = (totalIncome + totalExpense) / 2;
    const allAmounts = performanceData.flatMap((cat) => [cat.totalIncome, cat.totalExpense]);
    const highValue = allAmounts.length > 0 ? Math.max(...allAmounts) : 0;
    const lowValue = allAmounts.length > 0 ? Math.min(...allAmounts) : 0;

    setSummaryData({
      totalCategories: categoriesList.length,
      activeCategories: activeCategories.length,
      totalIncome,
      totalExpense,
      highPerformanceCategories,
      averageEfficiency,
      topPerformer,
      monthlyAverage,
      highValue,
      lowValue,
    });
  };

  // Fetch transactions for selected category and month
  const fetchCategoryTransactions = (categoryId) => {
    if (!categoryId) return;

    setLoading(true);
    const payload = {
      FilterBy: { CategoryId: categoryId },
      Duration: 'All',
    };

    dispatch(
      TransactionFetchListService(payload, (res) => {
        if (res?.status) {
          setCategoryTransactions(res?.data?.list || []);
          const analytics = analyzeAllMonthsCategoryPerformance(res?.data?.list || []);
          setAllMonthsData(analytics);
        }
        setLoading(false);
      })
    );
  };

  const handleTabChange = (event, newValue) => {
    setActiveTab(newValue);
  };

  const handleCategorySelect = (category) => {
    setSelectedCategory(category);
    setActiveTab(1);
  };

  const handleMonthChange = (month) => {
    setSelectedMonth(month);
    if (selectedCategory?.CategoryId) {
      fetchCategoryTransactions(selectedCategory.CategoryId);
    }
  };

  useEffect(() => {
    setLoadingList(true);
    dispatch(
      CategoriesFetchListService({}, (res) => {
        setLoadingList(false);
        if (res?.status) {
          setCategoriesList(res?.data?.list);
        }
      })
    );
  }, []);

  useEffect(() => {
    if (selectedCategory?.CategoryId) {
      fetchCategoryTransactions(selectedCategory.CategoryId);
    }
  }, [selectedCategory]);

  useEffect(() => {
    if (categoriesList?.length > 0) {
      calculateSummary();
    }
  }, [categoriesList, selectedMonth]);

  const renderOverview = () => {
    const performanceData = getMonthPerformanceForAllCategories(categoriesList, selectedMonth);

    console.log(performanceData , "performanceData ,performanceData");
    

    return (
      <Box>
        <CardHeader
          title={
            <Typography variant="h6" sx={{ fontWeight: 600 }}>
              Categories Performance - {performanceData[0]?.monthName || selectedMonth}
            </Typography>
          }
          subheader={`${summaryData.totalCategories} total categories • ${summaryData.activeCategories} active • ${summaryData.highPerformanceCategories} high performing`}
          action={
            <Stack direction="row" spacing={2} alignItems="center">
              <CustomSelect
                valueKey="Key"
                labelKey="Value"
                size="small"
                sx={{ width: 120 }}
                menuList={MonthList}
                defaultValue={selectedMonth}
                callBackAction={handleMonthChange}
              />
            </Stack>
          }
        />

        <Box sx={{ p: 2 }}>
          <Grid item xs={12} md={12}>
            <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
              <AnimatedChart
                title="Top Categories Performance by Expense"
                height={300}
                animationDuration={2000}
                chart={{
                  labels: performanceData.slice(0, 8).map((item) => item.CategoryName),
                  series: [
                    {
                      name: 'Expense',
                      type: 'bar',
                      fill: 'solid',
                      color: '#00B8D9',
                      data: performanceData.slice(0, 8).map((item) => item.totalExpense),
                    },
                  ],
                  options: {
                    yaxis: {
                      labels: {
                        show: true,
                      },
                    },
                    plotOptions: {
                      bar: {
                        columnWidth: '60%',
                        borderRadius: 4,
                      },
                    },
                    xaxis: {
                      labels: {
                        rotate: -45,
                        style: {
                          fontSize: '12px',
                        },
                      },
                    },
                  },
                }}
              />
            </Box>
          </Grid>

          {/* Enhanced Charts */}
          <Grid container spacing={3} sx={{ mb: 3 }}>
            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title={`Monthly Income vs Expense - ${selectedMonth}`}
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: [selectedMonth],
                    series: [
                      {
                        name: 'Income',
                        type: 'bar',
                        fill: 'solid',
                        color: '#00A76F',
                        data: [summaryData?.totalIncome || 0],
                      },
                      {
                        name: 'Expense',
                        type: 'bar',
                        fill: 'solid',
                        color: '#FF4842',
                        data: [summaryData?.totalExpense || 0],
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Performance Distribution"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: ['High', 'Medium', 'Low'],
                    series: [
                      {
                        name: 'Categories',
                        type: 'pie',
                        data: [
                          performanceData.filter((cat) => cat.performance === 'High').length,
                          performanceData.filter((cat) => cat.performance === 'Medium').length,
                          performanceData.filter((cat) => cat.performance === 'Low').length,
                        ],
                      },
                    ],
                    options: {
                      colors: ['#00A76F', '#FFA726', '#FF4842'],
                    },
                  }}
                />
              </Box>
            </Grid>

            <Grid item xs={12} md={6}>
              <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                <AnimatedChart
                  title="Monthly Average Comparison"
                  height={300}
                  animationDuration={2000}
                  chart={{
                    labels: performanceData.slice(0, 10).map((item) => item.CategoryName),
                    series: [
                      {
                        name: 'Monthly Average',
                        type: 'line',
                        fill: 'gradient',
                        color: '#8E44AD',
                        data: performanceData.slice(0, 10).map((item) => item.monthlyAverage),
                      },
                    ],
                  }}
                />
              </Box>
            </Grid>
          </Grid>

          {/* Enhanced Performance Table */}
          <Card sx={{ mb: 3 }}>
            <CardHeader
              title={
                <Typography variant="h6" sx={{ fontWeight: 600 }}>
                  Detailed Category Performance - {selectedMonth}
                </Typography>
              }
              subheader="Comprehensive monthly performance analysis with averages and value ranges"
            />
            <TableContainer>
              <Table>
                <TableHead>
                  <TableRow>
                    <TableCell>Category</TableCell>
                    <TableCell align="right">Income</TableCell>
                    <TableCell align="right">Expense</TableCell>
                    <TableCell align="right">Net Flow</TableCell>
                    <TableCell align="right">Monthly Avg</TableCell>
                    <TableCell align="right">Transactions</TableCell>
                    <TableCell align="center">Performance</TableCell>
                    <TableCell align="center">Status</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {performanceData.map((category, index) => (
                    <TableRow key={index} hover>
                      <TableCell>
                        <Stack direction="row" alignItems="center" spacing={1}>
                          <CustomAvatar
                            width={30}
                            height={30}
                            iconSize={12}
                            icon={category?.Icon || 'category'}
                            bgColor={category?.Color || '#00A76F'}
                          />
                          <Box>
                            <Typography variant="body2" sx={{ fontWeight: 500 }}>
                              {category.CategoryName}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {category.Description || 'No description'}
                            </Typography>
                          </Box>
                        </Stack>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" color="success.main" sx={{ fontWeight: 500 }}>
                          ₹{category.totalIncome.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" color="error.main" sx={{ fontWeight: 500 }}>
                          ₹{category.totalExpense.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Stack
                          direction="row"
                          alignItems="center"
                          justifyContent="flex-end"
                          spacing={0.5}
                        >
                          {category.netFlow >= 0 ? (
                            <TrendingUpIcon sx={{ fontSize: 16, color: 'success.main' }} />
                          ) : (
                            <TrendingDownIcon sx={{ fontSize: 16, color: 'error.main' }} />
                          )}
                          <Typography
                            variant="body2"
                            color={category.netFlow >= 0 ? 'success.main' : 'error.main'}
                            sx={{ fontWeight: 500 }}
                          >
                            ₹{category.netFlow.toFixed(2)}
                          </Typography>
                        </Stack>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" sx={{ fontWeight: 500 }}>
                          ₹{category.monthlyAverage.toFixed(2)}
                        </Typography>
                      </TableCell>

                      <TableCell align="right">
                        <Typography variant="body2" sx={{ fontWeight: 500 }}>
                          {category.transactionCount}
                        </Typography>
                      </TableCell>

                      <TableCell align="center">
                        <Chip
                          label={category.performance}
                          size="small"
                          color={
                            category.performance === 'High'
                              ? 'success'
                              : category.performance === 'Medium'
                              ? 'warning'
                              : 'error'
                          }
                          variant="outlined"
                        />
                      </TableCell>

                      <TableCell align="center">
                        <Stack direction="row" spacing={1} justifyContent="center">
                          <Chip
                            label={category.isActive ? 'Active' : 'Inactive'}
                            size="small"
                            color={category.isActive ? 'success' : 'default'}
                            variant="outlined"
                          />
                        </Stack>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
          </Card>
        </Box>
      </Box>
    );
  };

  const renderSelectedCategory = () => {
    if (!selectedCategory) {
      return (
        <Box sx={{ p: 4, textAlign: 'center' }}>
          <CategoryIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
          <Typography variant="h6" color="text.secondary" sx={{ mb: 1 }}>
            No Category Selected
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Select a category from the sidebar to view detailed analytics
          </Typography>
        </Box>
      );
    }

    return (
      <Box>
        <CardHeader
          title={
            <Stack direction="row" alignItems="center" spacing={1}>
              <CustomAvatar
                width={{ xs: 40, md: 45, lg: 56 }}
                height={{ xs: 40, md: 45, lg: 56 }}
                iconSize={20}
                icon={selectedCategory?.Icon || 'category'}
                bgColor={selectedCategory?.Color || '#00A76F'}
              />
              <Box>
                <Typography variant="body1" sx={{ fontWeight: 600 }}>
                  {selectedCategory?.CategoryName}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  {selectedCategory?.Description || 'No description'}
                </Typography>
              </Box>
            </Stack>
          }
          action={
            <CustomSelect
              valueKey="Key"
              labelKey="Value"
              size="small"
              sx={{ width: 120 }}
              menuList={MonthList}
              defaultValue={selectedMonth}
              callBackAction={handleMonthChange}
            />
          }
        />

        <Box sx={{ p: 2 }}>
          {/* Yearly Summary Cards */}
          {allMonthsData?.yearlySummary && (
            <Grid container spacing={2} sx={{ mb: 1.5 }}>
              <Grid item xs={12} sm={6} md={4}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter' }}>
                  <AttachMoneyIcon sx={{ fontSize: 32, color: 'success.main', mb: 1 }} />
                  <AnimatedCounter
                    value={allMonthsData.yearlySummary.totalIncome}
                    format="currency"
                    variant="h5"
                    color="success.main"
                    duration={2000}
                  />
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                    Yearly Income
                  </Typography>
                  <Typography variant="caption" color="success.main">
                    All 12 months
                  </Typography>
                </Card>
              </Grid>

              <Grid item xs={12} sm={6} md={4}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter' }}>
                  <TrendingDownIcon sx={{ fontSize: 32, color: 'error.main', mb: 1 }} />
                  <AnimatedCounter
                    value={allMonthsData.yearlySummary.totalExpense}
                    format="currency"
                    variant="h5"
                    color="error.main"
                    duration={2000}
                  />
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                    Yearly Expense
                  </Typography>
                  <Typography variant="caption" color="error.main">
                    All 12 months
                  </Typography>
                </Card>
              </Grid>

              <Grid item xs={12} sm={6} md={4}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'info.lighter' }}>
                  <CalendarTodayIcon sx={{ fontSize: 32, color: 'info.main', mb: 1 }} />
                  <AnimatedCounter
                    value={allMonthsData.yearlySummary.totalTransactions}
                    format="number"
                    variant="h5"
                    color="info.main"
                    duration={2000}
                  />
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                    Total Transactions
                  </Typography>
                  <Typography variant="caption" color="info.main">
                    All 12 months
                  </Typography>
                </Card>
              </Grid>
            </Grid>
          )}

          {/* Best/Worst Month and High/Low Values */}
          {allMonthsData?.yearlySummary && (
            <Grid container spacing={2} sx={{ mb: 3 }}>
              <Grid item xs={12} sm={6} md={3}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'success.lighter' }}>
                  <TrendingUpIcon sx={{ fontSize: 24, color: 'success.main', mb: 1 }} />
                  <Typography variant="h6" color="success.main">
                    {allMonthsData.yearlySummary.bestMonth?.month || 'N/A'}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    Best Month
                  </Typography>
                  <Typography variant="caption" color="success.main">
                    ₹{allMonthsData.yearlySummary.bestMonth?.netFlow?.toFixed(2) || 0}
                  </Typography>
                </Card>
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'error.lighter' }}>
                  <TrendingDownIcon sx={{ fontSize: 24, color: 'error.main', mb: 1 }} />
                  <Typography variant="h6" color="error.main">
                    {allMonthsData.yearlySummary.worstMonth?.month || 'N/A'}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    Worst Month
                  </Typography>
                  <Typography variant="caption" color="error.main">
                    ₹{allMonthsData.yearlySummary.worstMonth?.netFlow?.toFixed(2) || 0}
                  </Typography>
                </Card>
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'warning.lighter' }}>
                  <TrendingUpIcon sx={{ fontSize: 24, color: 'warning.main', mb: 1 }} />
                  <Typography variant="h6" color="warning.main">
                    ₹{allMonthsData.yearlySummary.highValue?.toFixed(2) || 0}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    Highest Value
                  </Typography>
                  <Typography variant="caption" color="warning.main">
                    Single transaction
                  </Typography>
                </Card>
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <Card sx={{ p: 2, textAlign: 'center', bgcolor: 'info.lighter' }}>
                  <TrendingDownIcon sx={{ fontSize: 24, color: 'info.main', mb: 1 }} />
                  <Typography variant="h6" color="info.main">
                    ₹{allMonthsData.yearlySummary.lowValue?.toFixed(2) || 0}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    Lowest Value
                  </Typography>
                  <Typography variant="caption" color="info.main">
                    Single transaction
                  </Typography>
                </Card>
              </Grid>
            </Grid>
          )}

          {/* All Months Charts */}
          {allMonthsData?.monthlyData && (
            <Grid container spacing={3} sx={{ mb: 3 }}>
              {/* Monthly Income vs Expense - All Months */}
              <Grid item xs={12} md={12}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Monthly Income vs Expense - All Months"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: allMonthsData.monthlyData.map((month) => month.month),
                      series: [
                        {
                          name: 'Income',
                          type: 'bar',
                          fill: 'solid',
                          color: '#00A76F',
                          data: allMonthsData.monthlyData.map((month) => month.income),
                        },
                        {
                          name: 'Expense',
                          type: 'bar',
                          fill: 'solid',
                          color: '#FF4842',
                          data: allMonthsData.monthlyData.map((month) => month.expense),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>

              {/* Monthly Transaction Count */}
              <Grid item xs={12} md={6}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Monthly Transaction Count"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: allMonthsData.monthlyData.map((month) => month.month),
                      series: [
                        {
                          name: 'Transactions',
                          type: 'column',
                          fill: 'solid',
                          color: '#00B8D9',
                          data: allMonthsData.monthlyData.map((month) => month.transactionCount),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>

              {/* Monthly Net Flow Trends */}
              <Grid item xs={12} md={6}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Monthly Net Flow Trends"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: allMonthsData.monthlyData.map((month) => month.month),
                      series: [
                        {
                          name: 'Net Flow',
                          type: 'line',
                          // fill: 'gradient',
                          color: '#8E44AD',
                          data: allMonthsData.monthlyData.map((month) => month.netFlow),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>

              {/* Monthly Averages */}
              <Grid item xs={12} md={6}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Monthly Averages"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: allMonthsData.monthlyData.map((month) => month.month),
                      series: [
                        {
                          name: 'Monthly Average',
                          type: 'area',
                          fill: 'gradient',
                          color: '#FFA726',
                          data: allMonthsData.monthlyData.map((month) => month.monthlyAverage),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>
            </Grid>
          )}

          {/* Daily and Weekly Analysis Charts */}
          {allMonthsData?.yearlySummary && (
            <Grid container spacing={3} sx={{ mb: 3 }}>
              {/* Daily Spending Pattern (1-31) */}
              <Grid item xs={12} md={6}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Daily Spending Pattern (1-31)"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: Object.keys(allMonthsData.yearlySummary.dayBreakdown || {}).map(
                        (day) => `Day ${day}`
                      ),
                      series: [
                        {
                          name: 'Income',
                          type: 'bar',
                          fill: 'solid',
                          color: '#00A76F',
                          data: Object.values(allMonthsData.yearlySummary.dayBreakdown || {}).map(
                            (day) => day.income
                          ),
                        },
                        {
                          name: 'Expense',
                          type: 'bar',
                          fill: 'solid',
                          color: '#FF4842',
                          data: Object.values(allMonthsData.yearlySummary.dayBreakdown || {}).map(
                            (day) => day.expense
                          ),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>

              {/* Weekly Spending Pattern (Mon-Sun) */}
              <Grid item xs={12} md={6}>
                <Box sx={{ border: 'solid 1px #EEE', borderRadius: 1 }}>
                  <AnimatedChart
                    title="Weekly Spending Pattern (Mon-Sun)"
                    height={300}
                    animationDuration={2000}
                    chart={{
                      labels: Object.keys(allMonthsData.yearlySummary.weekdayBreakdown || {}),
                      series: [
                        {
                          name: 'Income',
                          type: 'bar',
                          fill: 'solid',
                          color: '#00A76F',
                          data: Object.values(
                            allMonthsData.yearlySummary.weekdayBreakdown || {}
                          ).map((day) => day.income),
                        },
                        {
                          name: 'Expense',
                          type: 'bar',
                          fill: 'solid',
                          color: '#FF4842',
                          data: Object.values(
                            allMonthsData.yearlySummary.weekdayBreakdown || {}
                          ).map((day) => day.expense),
                        },
                      ],
                    }}
                  />
                </Box>
              </Grid>
            </Grid>
          )}

          {/* All Months Performance Table */}
          {allMonthsData?.monthlyData && (
            <Card sx={{ mb: 3 }}>
              <CardHeader
                title={
                  <Typography variant="h6" sx={{ fontWeight: 600 }}>
                    Monthly Performance Analysis - All 12 Months
                  </Typography>
                }
                subheader="Comprehensive monthly breakdown with income, expense, net flow, and key metrics"
              />
              <TableContainer>
                <Table>
                  <TableHead>
                    <TableRow>
                      <TableCell>Month</TableCell>
                      <TableCell align="right">Income</TableCell>
                      <TableCell align="right">Expense</TableCell>
                      <TableCell align="right">Net Flow</TableCell>
                      <TableCell align="right">Transactions</TableCell>
                      <TableCell align="right">Monthly Avg</TableCell>
                      <TableCell align="right">High Value</TableCell>
                      <TableCell align="right">Low Value</TableCell>
                      <TableCell align="center">Peak Day</TableCell>
                      <TableCell align="center">Peak Hour</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {allMonthsData.monthlyData.map((month, index) => (
                      <TableRow key={index} hover>
                        <TableCell>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {month.month}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" color="success.main" sx={{ fontWeight: 500 }}>
                            ₹{month.income.toFixed(2)}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" color="error.main" sx={{ fontWeight: 500 }}>
                            ₹{month.expense.toFixed(2)}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Stack
                            direction="row"
                            alignItems="center"
                            justifyContent="flex-end"
                            spacing={0.5}
                          >
                            {month.netFlow >= 0 ? (
                              <TrendingUpIcon sx={{ fontSize: 16, color: 'success.main' }} />
                            ) : (
                              <TrendingDownIcon sx={{ fontSize: 16, color: 'error.main' }} />
                            )}
                            <Typography
                              variant="body2"
                              color={month.netFlow >= 0 ? 'success.main' : 'error.main'}
                              sx={{ fontWeight: 500 }}
                            >
                              ₹{month.netFlow.toFixed(2)}
                            </Typography>
                          </Stack>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {month.transactionCount}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            ₹{month.monthlyAverage.toFixed(2)}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" color="success.main" sx={{ fontWeight: 500 }}>
                            ₹{month.highValue.toFixed(2)}
                          </Typography>
                        </TableCell>

                        <TableCell align="right">
                          <Typography variant="body2" color="error.main" sx={{ fontWeight: 500 }}>
                            ₹{month.lowValue.toFixed(2)}
                          </Typography>
                        </TableCell>

                        <TableCell align="center">
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            Day {month.peakDay?.day || 1}
                          </Typography>
                        </TableCell>

                        <TableCell align="center">
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {month.peakHour?.hour || 0}:00
                          </Typography>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            </Card>
          )}

          {/* Yearly Statistics */}
          {allMonthsData?.yearlySummary && (
            <Grid container spacing={2} sx={{ mb: 3 }}>
              <Grid item xs={12} md={6}>
                <Card sx={{ p: 2 }}>
                  <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
                    Yearly Statistics
                  </Typography>
                  <Stack spacing={1}>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Total Income:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.totalIncome.toFixed(2)}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Total Expense:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.totalExpense.toFixed(2)}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Net Flow:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.totalNetFlow.toFixed(2)}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Total Transactions:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        {allMonthsData.yearlySummary.totalTransactions}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Growth Rate:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        {allMonthsData.yearlySummary.growthRate.toFixed(1)}%
                      </Typography>
                    </Box>
                  </Stack>
                </Card>
              </Grid>

              <Grid item xs={12} md={6}>
                <Card sx={{ p: 2 }}>
                  <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
                    Monthly Averages
                  </Typography>
                  <Stack spacing={1}>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Avg Monthly Income:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.averageMonthlyIncome.toFixed(2)}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Avg Monthly Expense:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.averageMonthlyExpense.toFixed(2)}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Best Month:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        {allMonthsData.yearlySummary.bestMonth?.month || 'N/A'}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Worst Month:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        {allMonthsData.yearlySummary.worstMonth?.month || 'N/A'}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                      <Typography variant="body2">Highest Value:</Typography>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>
                        ₹{allMonthsData.yearlySummary.highValue.toFixed(2)}
                      </Typography>
                    </Box>
                  </Stack>
                </Card>
              </Grid>
            </Grid>
          )}
        </Box>
      </Box>
    );
  };

  return (
    <Grid container spacing={2} sx={{ mb: 3 }}>
      <Grid item xs={12} md={3}>
        <Card>
          <CardHeader
            title={
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                Categories List
              </Typography>
            }
            subheader="Click on an item to view detailed analytics"
          />
          <Divider sx={{ m: 2 }} />

          {loadingList ? (
            <Grid container spacing={2} sx={{ py: 1 }}>
              {[1, 2, 3, 4].map((item) => (
                <Grid item xs={12} key={item}>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, px: 2.5 }}>
                    <Skeleton variant="circular" width={40} height={40} />
                    <Box sx={{ flex: 1 }}>
                      <Skeleton variant="text" width="60%" />
                      <Skeleton variant="text" width="40%" />
                    </Box>
                  </Box>
                </Grid>
              ))}
            </Grid>
          ) : (
            <>
              {categoriesList?.map((item, index) => (
                <ListItem key={item.CategoryId || index} disablePadding>
                  <ListItemButton
                    onClick={() => handleCategorySelect(item)}
                    sx={{
                      '&.Mui-selected': {
                        bgcolor: 'primary.lighter',
                        '&:hover': {
                          bgcolor: 'primary.lighter',
                        },
                      },
                    }}
                  >
                    <Stack direction="row" alignItems="center" spacing={2}>
                      <CustomAvatar
                        width={45}
                        height={45}
                        iconSize={15}
                        icon={item?.Icon || ''}
                        bgColor={item?.Color || ''}
                      />
                      <Typography variant="light">
                        {item?.CategoryName}
                        <Typography variant="registerTest" color="text.secondary">
                          {item?.isActive ? 'Active' : 'Inactive'} •{' '}
                          {item?.isUsing ? 'Using' : 'Not Using'}
                        </Typography>
                      </Typography>
                    </Stack>
                  </ListItemButton>
                </ListItem>
              ))}
            </>
          )}
        </Card>
      </Grid>

      <Grid item xs={12} md={9}>
        <Card>
          <CardHeader
            title={
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                Categories Analytics
              </Typography>
            }
          />
          <Box sx={{ borderBottom: 1, borderColor: 'divider', mx: 2 }}>
            <Tabs
              value={activeTab}
              onChange={handleTabChange}
              variant="scrollable"
              scrollButtons="auto"
            >
              <Tab label="All Categories" />
              <Tab label="Selected Category" />
            </Tabs>
          </Box>

          {activeTab === 0 && renderOverview()}
          {activeTab === 1 && renderSelectedCategory()}
        </Card>
      </Grid>
    </Grid>
  );
}
